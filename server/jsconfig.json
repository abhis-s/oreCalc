{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "maxNodeModuleJsDepth": 0,
    "lib": ["ES2022"]
  },
  "include": [
    "constants.js",
    "main.js",
    "scripts/**/*",
    "utils/**/*",
    "services/**/*",
    "routes/**/*",
    "tests/**/*"
  ],
  "exclude": [
    "node_modules",
    "../node_modules"
  ]
}
