{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": [
    "js/**/*",
    "types/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "js/qr-code-styling.js",
    "js/workbox-window.js"
  ]
}
