{
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "workbox-window": "^7.4.1"
  },
  "packageManager": "pnpm@11.3.0",
  "name": "clashcalc-frontend",
  "version": "3.0.0",
  "description": "",
  "main": "service-worker.js",
  "scripts": {
    "preinstall": "node scripts/ensure-pnpm.js",
    "pretest": "node scripts/ensure-pnpm.js",
    "pretest:unit": "node scripts/ensure-pnpm.js",
    "pretypecheck": "node scripts/ensure-pnpm.js",
    "prelint": "node scripts/ensure-pnpm.js",
    "prelint:exports": "node scripts/ensure-pnpm.js",
    "prei18n:validate": "node scripts/ensure-pnpm.js",
    "predev": "node scripts/ensure-pnpm.js",
    "prebuild": "node scripts/ensure-pnpm.js",
    "prestart": "node scripts/ensure-pnpm.js",
    "test": "node scripts/check-undefined-vars.js && node scripts/check-unused-exports.js && tsc --noEmit && tsc --project server/jsconfig.json --noEmit && node scripts/run-tests.js && node scripts/validate-i18n.js",
    "test:unit": "node scripts/run-tests.js",
    "test:temp": "node --test tests/temp/**/*.test.js",
    "typecheck": "tsc --noEmit && tsc --project server/jsconfig.json --noEmit",
    "lint": "node scripts/check-undefined-vars.js && node scripts/check-unused-exports.js && tsc --noEmit && tsc --project server/jsconfig.json --noEmit",
    "lint:scope": "node scripts/check-undefined-vars.js",
    "lint:exports": "node scripts/check-unused-exports.js",
    "lint:types": "tsc --noEmit && tsc --project server/jsconfig.json --noEmit",
    "i18n:validate": "node scripts/validate-i18n.js",
    "crowdin:sync": "crowdin upload sources && crowdin download",
    "crowdin:upload": "crowdin upload sources",
    "crowdin:upload:translations": "crowdin upload translations --auto-approve-imported --import-eq-suggestions",
    "crowdin:download": "node scripts/crowdin-download.js",
    "dev": "node scripts/dev/run-dev.js",
    "watch:sass": "node scripts/dev/watch-sass.js",
    "watch:js": "node scripts/dev/watch-js.js",
    "dev:server": "node -r dotenv/config scripts/dev/start-dev-server.js",
    "build": "PUBLIC_API_BASE_URL=https://api.clashcalc.com pnpm run build:assets",
    "build:dev": "PUBLIC_API_BASE_URL=http://localhost:3000 pnpm run build:assets",
    "build:assets": "node scripts/fetch-billing-costs.js && node scripts/validate-i18n.js && node scripts/build.js && pnpm run build:css && pnpm run build:sw",
    "build:css": "sass css/main.scss dist/css/main.min.css --style compressed && sass css/hero-journey.scss dist/css/hero-journey.min.css --style compressed && sass css/landing.scss dist/css/landing.min.css --style compressed && sass css/damage-calculator.scss dist/css/damage-calculator.min.css --style compressed && sass css/account.scss dist/css/account.min.css --style compressed && sass legal/legal.scss dist/legal/legal.css --style compressed",
    "build:sw": "workbox injectManifest workbox-config.js",
    "bump": "node scripts/bump.js",
    "generate:og": "node scripts/dev/generate-og-images.js",
    "start": "node scripts/prod/start-prod-server.js"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@crowdin/cli": "^5.5.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "dotenv": "^18.0.9",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "live-server": "^1.2.2",
    "replace-in-file": "^9.0.0",
    "sass": "^1.106.1",
    "sharp": "^0.35.5",
    "terser": "^5.51.2",
    "typescript": "^7.0.2",
    "workbox-cli": "^7.4.1"
  }
}
